@grist.UserTable
class Millesimes:
  Type = grist.Choice()
  NomVariete = grist.Reference('Varietes')
  Origine = grist.ChoiceList()
  Nb_sachets = grist.Numeric()
  Millesime = grist.Date()
  Nb_saisons_manuel = grist.Choice()
  Qtte_graines = grist.Numeric()
  Germination_historique = grist.Numeric()
  Annee_germination_ref = grist.Numeric()
  Don = grist.Numeric()
  Plante_mere = grist.Bool()
  Annee_plantation = grist.Numeric()

  def _default_Date_creation(rec, table, value, user):
    return NOW()
  Date_creation = grist.Date()

  def _default_Date_modif(rec, table, value, user):
    return NOW()
  Date_modif = grist.DateTime('Europe/Paris')
  Statut_mere = grist.Choice()
  Controle_mere = grist.Date()
  Nb_plants = grist.Numeric()
  Melange = grist.Bool()
  Type_plant = grist.Choice()

  @grist.formulaType(grist.Numeric())
  def Germination_2026(rec, table):
    if rec.Plante_mere:
        return None
    semis = Semis.lookupRecords(NomVariete=rec.NomVariete, Millesime=rec.id)
    vals = [v for v in semis.Germination_annee if v is not None]
    return max(vals) if vals else None

  @grist.formulaType(grist.Numeric())
  def Germination_affichee(rec, table):
    if rec.Plante_mere:
        return None
    return rec.Germination_2026 if rec.Germination_2026 is not None else rec.Germination_historique

  @grist.formulaType(grist.Bool())
  def Millesime_recent(rec, table):
    return max((r.Millesime.year for r in Millesimes.lookupRecords(NomVariete=rec.NomVariete) if r.Millesime), default=0) == (rec.Millesime.year if rec.Millesime else -1)

  def Germes(rec, table):
    return sum(g or 0 for g in Semis.lookupRecords(NomVariete=rec.NomVariete, Millesime=rec.id).Germes)

  def Plantes(rec, table):
    if rec.Plante_mere:
        return rec.Nb_plants or 0
    return sum(g or 0 for g in Semis.lookupRecords(NomVariete=rec.NomVariete, Millesime=rec.id).Plantes)

  @grist.formulaType(grist.Numeric())
  def Duree_cons_ecoulee(rec, table):
    return None if (rec.Epuise or rec.Plante_mere or not rec.NomVariete.Conservation or not rec.Millesime) else (TODAY().year - rec.Millesime.year) / rec.NomVariete.Conservation

  def Nom(rec, table):
    return rec.NomVariete.Nom

  def Variete(rec, table):
    return rec.Annees_sans_test

  def Annees_sans_test(rec, table):
    if rec.Plante_mere:
        return None
    dates = [s.Date_s for s in Semis.lookupRecords(NomVariete=rec.NomVariete, Millesime=rec.id) if s.Date_s]
    dernier_semis = max(dates) if dates else None
    if dernier_semis:
        return TODAY().year - dernier_semis.year
    elif rec.Annee_germination_ref:
        return TODAY().year - rec.Annee_germination_ref
    else:
        return "Jamais testé"

  @grist.formulaType(grist.Bool())
  def Epuise(rec, table):
    return (not rec.Plante_mere) and (not rec.Qtte_graines) and (not rec.Nb_sachets)


  def Nb_saisons(rec, table):
    if rec.Plante_mere:
        if not rec.Annee_plantation:
            return "or."
        return int(TODAY().year - rec.Annee_plantation + 1)  # 2026 = année actuelle, +1 pour compter l'année de plantation
    else:
        return rec.Nb_saisons_manuel

  @grist.formulaType(grist.Text())
  def Germination_cahier(rec, table):
    if rec.Plante_mere:
        return ""
    semis = [s for s in Semis.lookupRecords(NomVariete=rec.NomVariete, Millesime=rec.id)
             if s.Germination_annee is not None and s.Date_s]
    if semis:
        dernier = max(semis, key=lambda s: s.Date_s)
        val, annee = dernier.Germination_annee, dernier.Date_s.year
    elif rec.Germination_historique is not None:
        val, annee = rec.Germination_historique, rec.Annee_germination_ref
    else:
        return ""
    txt = "{:.0f}% ".format(val * 100)
    if annee:
        txt += "({:02d})".format(int(annee) % 100)
    return txt


